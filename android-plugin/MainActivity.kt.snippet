/*
 * Snippet — paste the relevant parts into your generated MainActivity after
 * running `bunx cap add android`. The full file lives at:
 *   android/app/src/main/java/com/barcodewarehouse/uhftagfinder/MainActivity.kt
 *
 * Key things this does:
 *   1) Registers the ZebraTC22R plugin
 *   2) Captures the integrated scan trigger on the Zebra TC22R / TC27R and
 *      forwards press/release to the plugin.
 *      IMPORTANT: disable/undefine the RFID trigger in DataWedge for this
 *      app's profile, otherwise DataWedge consumes the trigger and the SDK
 *      never sees it.
 */
package com.barcodewarehouse.uhftagfinder

import android.os.Bundle
import android.view.KeyEvent
import com.getcapacitor.BridgeActivity

class MainActivity : BridgeActivity() {

    // Hardware trigger keycodes for the TC22R / TC27R integrated trigger.
    //   10036      -> Zebra "SCAN" key on the all-in-one handheld
    //   131 / 132  -> used by some DataWedge profiles
    // The SDK usually also raises HANDHELD_TRIGGER status events, so the
    // plugin de-dupes: either path starts/stops the same operation.
    private val triggerKeyCodes = setOf(10036, 131, 132)

    override fun onCreate(savedInstanceState: Bundle?) {
        registerPlugin(ZebraTC22RPlugin::class.java)
        super.onCreate(savedInstanceState)
    }

    override fun dispatchKeyEvent(event: KeyEvent): Boolean {
        if (event.keyCode in triggerKeyCodes) {
            when (event.action) {
                KeyEvent.ACTION_DOWN -> {
                    if (event.repeatCount == 0) {
                        ZebraTC22RPlugin.instance?.notifyTriggerPressed()
                    }
                    return true
                }
                KeyEvent.ACTION_UP -> {
                    ZebraTC22RPlugin.instance?.notifyTriggerReleased()
                    return true
                }
            }
        }
        return super.dispatchKeyEvent(event)
    }
}
