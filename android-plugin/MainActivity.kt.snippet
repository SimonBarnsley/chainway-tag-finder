/*
 * Snippet — paste the relevant parts into your generated MainActivity after
 * running `bunx cap add android`. The full file lives at:
 *   android/app/src/main/java/com/barcodewarehouse/uhftagfinder/MainActivity.kt
 *
 * Key things this does:
 *   1) Registers the ZebraRFD40 plugin
 *   2) Captures the hardware trigger key sent by the e-Connex adapter when
 *      the TC22 is docked into the RFD40 sled OR the integrated trigger on a
 *      TC22R is pulled, and forwards press/release to the plugin.
 *      IMPORTANT on TC22R: disable/undefine the RFID trigger in DataWedge for
 *      this app's profile, otherwise DataWedge consumes the trigger and the
 *      SDK never sees it.
 */
package com.barcodewarehouse.uhftagfinder

import android.os.Bundle
import android.view.KeyEvent
import com.getcapacitor.BridgeActivity

class MainActivity : BridgeActivity() {

    // Hardware trigger keycodes.
    //   293 / 280  -> RFD40 sled via e-Connex
    //   10036      -> TC22R / TC27R integrated scan trigger (Zebra "SCAN" key)
    //   KEYCODE 131/132 are also used by some DataWedge profiles.
    // On the TC22R the SDK usually also raises HANDHELD_TRIGGER status events,
    // so the plugin de-dupes: either path starts/stops the same operation.
    private val triggerKeyCodes = setOf(293, 280, 10036, 131, 132)

    override fun onCreate(savedInstanceState: Bundle?) {
        registerPlugin(ZebraRFD40Plugin::class.java)
        super.onCreate(savedInstanceState)
    }

    override fun dispatchKeyEvent(event: KeyEvent): Boolean {
        if (event.keyCode in triggerKeyCodes) {
            when (event.action) {
                KeyEvent.ACTION_DOWN -> {
                    if (event.repeatCount == 0) {
                        ZebraRFD40Plugin.instance?.notifyTriggerPressed()
                    }
                    return true
                }
                KeyEvent.ACTION_UP -> {
                    ZebraRFD40Plugin.instance?.notifyTriggerReleased()
                    return true
                }
            }
        }
        return super.dispatchKeyEvent(event)
    }
}
